{
  "schemaVersion": 1,
  "items": [
    {
      "id": "duration-sensitivity",
      "title": "两个探索面板中的 ECRS 请求裁剪与最优收益差异",
      "queries": [
        {
          "id": "gate-outcomes",
          "source": {
            "label": "ECRS gate pilot outputs",
            "files": [
              {
                "label": "February protocol and summary.json"
              },
              {
                "label": "January protocol and summary.json"
              }
            ],
            "metricDefinitions": [
              {
                "label": "请求裁剪比例",
                "definition": "请求裁剪比例是在一小时执行模型中被削减 ECRS 请求的时段数，除以同一面板全部 864 个时段。"
              },
              {
                "label": "最优收益下降",
                "definition": "最优收益下降比较同一面板的 0.25 小时与一小时 oracle，以前者净收益代理为分母。"
              }
            ],
            "caveats": [
              "两个面板使用第三方处理后价格，仅用于探索；不是独立留出验证。",
              "无辅助服务实际部署，LMP/MCPC 现金流是简化代理，不是真实完整结算。",
              "0.25 小时是相关实现参数的敏感性检查，不是历史旧市场规则。"
            ]
          },
          "reportingPeriod": "2026-02-02–04 与 2026-01-24–26，US/Central",
          "columns": [
            "panel",
            "intervals",
            "clipped",
            "clipped_pct",
            "oracle_loss_pct",
            "legal_mpc_usd",
            "relaxed_mpc_executed_legally_usd"
          ],
          "rows": [
            {
              "panel": "february_pilot",
              "intervals": 864,
              "clipped": 154,
              "clipped_pct": 17.824074074074073,
              "oracle_1h_usd": 24425.1065655578,
              "oracle_025h_usd": 24430.793171111414,
              "oracle_loss_pct": 0.023276385313350703,
              "legal_mpc_usd": 2137.360261712818,
              "relaxed_mpc_executed_legally_usd": 2430.2816235082764
            },
            {
              "panel": "january_stress_pilot",
              "intervals": 864,
              "clipped": 157,
              "clipped_pct": 18.171296296296298,
              "oracle_1h_usd": 212942.56786615786,
              "oracle_025h_usd": 213815.2414100874,
              "oracle_loss_pct": 0.40814374979741685,
              "legal_mpc_usd": -17854.09799474578,
              "relaxed_mpc_executed_legally_usd": -17180.276185048606
            }
          ],
          "methods": [
            {
              "language": "calculation",
              "code": "clipped_pct = 100 * clipped_ecrs_intervals / intervals\noracle_loss_pct = 100 * (oracle_025h_usd - oracle_1h_usd) / oracle_025h_usd"
            }
          ]
        }
      ]
    },
    {
